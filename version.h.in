// version.h.in — single source of truth for the K6WP version.
//
// Generated by CMake from K6WP_VERSION (root CMakeLists.txt) via
// configure_file(). Do not edit this file's values by hand — change
// K6WP_VERSION in the root CMakeLists.txt and reconfigure.
//
// Consumers: every app.rc / monitor_dump.rc (FILEVERSION/PRODUCTVERSION +
// FileVersion/ProductVersion strings), studio/src/update_checker.cpp
// (User-Agent), studio/src/main_window.cpp (About dialog). The NSIS
// installer consumes the sibling version.nsh; engine/app.manifest is
// configured from engine/app.manifest.in.
#pragma once

#define K6WP_VERSION_MAJOR @K6WP_VERSION_MAJOR@
#define K6WP_VERSION_MINOR @K6WP_VERSION_MINOR@
#define K6WP_VERSION_PATCH @K6WP_VERSION_PATCH@

// 3-part (K6WP_VERSION) and 4-part (K6WP_VERSION + ".0", VERSIONINFO / manifests).
#define K6WP_VERSION_STR "@K6WP_VERSION@"
#define K6WP_VERSION_STR_4 "@K6WP_VERSION_4@"

// Comma form for rc.exe FILEVERSION / PRODUCTVERSION.
#define K6WP_VERSION_COMMA @K6WP_VERSION_MAJOR@,@K6WP_VERSION_MINOR@,@K6WP_VERSION_PATCH@,0