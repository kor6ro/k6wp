{
  "_comment": "K6WP example studio settings, schema v3. Copy to %LOCALAPPDATA%/K6WP/studio_settings.json to override Studio defaults. Paths below use %LOCALAPPDATA% as a placeholder - replace with the expanded folder on your machine, or leave the file absent to use the built-in defaults (identical values).",
  "version": 3,
  "auto_compress_on_import": true,
  "compress_output_dir": "%LOCALAPPDATA%/K6WP/wallpapers",
  "default_crf": 22,
  "default_fps": 30,
  "default_resolution_mode": "match_monitor",
  "start_with_windows": false,
  "cache_dir": "%LOCALAPPDATA%/K6WP/cache",
  "lockscreen_sync": false,
  "lockscreen_offset_sec": 1.0,
  "compress_advanced_visible": false
}
