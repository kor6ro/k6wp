// design-tokens.slint - shared tokens for Studio Rust (Slint).
// Light/dark follow the system color scheme; font = Segoe UI Variable.
export global Tokens {
    // Colors (light; overridden at runtime via palette when dark)
    in-out property <color> bg: #ffffff;
    in-out property <color> fg: #1f1f1f;
    in-out property <color> muted: #6b6b6b;
    in-out property <color> accent: #0067c0;
    in-out property <color> card: #f3f3f3;
    in-out property <color> border: #d0d0d0;

    // Spacing
    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 12px;
    in-out property <length> space-lg: 16px;
    in-out property <length> space-xl: 24px;

    // Radius
    in-out property <length> radius-sm: 4px;
    in-out property <length> radius-md: 6px;
    in-out property <length> radius-lg: 8px;

    // Typography
    in-out property <string> font-family: "Segoe UI Variable";
    in-out property <length> font-sm: 12px;
    in-out property <length> font-md: 14px;
    in-out property <length> font-lg: 16px;
    in-out property <length> font-xl: 20px;

    // Motion
    in-out property <duration> motion-fast: 120ms;
    in-out property <duration> motion-med: 200ms;
    in-out property <bool> reduced-motion: false;
}
